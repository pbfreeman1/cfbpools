# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# CFBD API (collegefootballdata.com) — free key at https://collegefootballdata.com/key
CFBD_API_KEY=

# Resend (resend.com) — one verified sender per stream, chosen in lib/email.ts
# based on the kind of email being sent (see EmailStream). All three must be
# on a domain/subdomain verified in Resend, or sends from that stream fail.
RESEND_API_KEY=
# Pick confirmations + admin notifications (new account, new entry)
RESEND_FROM_PICKS=
# Entry welcome/confirmation emails
RESEND_FROM_WELCOME=
# Weekly recap / bulk announcement emails (not built yet)
RESEND_FROM_UPDATES=
# Where admin notifications (new account, new entry) get sent. Leave blank to skip those.
ADMIN_EMAIL=

# Set automatically by Vercel in each environment; only needed for local overrides
NEXT_PUBLIC_SITE_URL=http://localhost:3000
