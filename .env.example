# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (Project Settings > API > service_role). Server-only — never
# expose to the client. Used by the weekly-email cron, the unsubscribe page,
# and the bulk-unsubscribe suppression check in lib/email.ts.
SUPABASE_SERVICE_ROLE_KEY=

# CFBD API (collegefootballdata.com) — free key at https://collegefootballdata.com/key
CFBD_API_KEY=

# Resend (resend.com) — one verified sender per stream, chosen in lib/email.ts
# based on the kind of email being sent (see EmailStream). All three must be
# on a domain/subdomain verified in Resend, or sends from that stream fail.
RESEND_API_KEY=
# Pick confirmations + admin notifications (new account, new entry)
RESEND_FROM_PICKS=
# Entry welcome/confirmation emails
RESEND_FROM_WELCOME=
# Weekly recap / bulk announcement emails (Survivor + Pick'em weekly campaigns)
RESEND_FROM_UPDATES=
# Where admin notifications (new account, new entry) get sent. Leave blank to skip those.
ADMIN_EMAIL=

# Weekly pool email cron (app/api/cron/weekly-emails). Random 32+ char string;
# must match the value Vercel sends as the cron Authorization: Bearer token.
CRON_SECRET=
# HMAC key for one-click unsubscribe tokens (lib/email.ts signToken). Random 32+ chars.
EMAIL_UNSUB_SECRET=

# Set automatically by Vercel in each environment; only needed for local overrides
NEXT_PUBLIC_SITE_URL=http://localhost:3000
