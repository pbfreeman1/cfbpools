# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# CFBD API (collegefootballdata.com) — free key at https://collegefootballdata.com/key
CFBD_API_KEY=

# Resend (resend.com) — transactional email for welcome/confirmation/admin notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Where admin notifications (new account, new entry) get sent. Leave blank to skip those.
ADMIN_EMAIL=

# Set automatically by Vercel in each environment; only needed for local overrides
NEXT_PUBLIC_SITE_URL=http://localhost:3000
